#!/bin/sh
# Stand-in for gh in tests/file-issue-smoke.sh. It answers only the canned
# nodes below and fails every other lookup, so a script that links whatever
# number it was handed can't pass by luck. Every call is logged one line per
# invocation, which is how the suite asserts which mutations went out.
# An updateIssue body spans lines, so it goes to a side file and the log line
# names the file instead; the log stays one line per call.
logline=""
for a in "$@"; do
  case "$a" in
    body=*) printf '%s' "${a#body=}" > "${FAKE_GH_LOG:?FAKE_GH_LOG must name the call log}.body"; a='body=@body' ;;
  esac
  logline="$logline$a "
done
printf '%s\n' "${logline% }" >> "${FAKE_GH_LOG:?FAKE_GH_LOG must name the call log}"

if [ "$1" = "repo" ] && [ "$2" = "view" ]; then
  printf '{"nameWithOwner":"o/r"}\n'
  exit 0
fi

if [ "$1" != "api" ] || [ "$2" != "graphql" ]; then
  echo "fake-gh: unhandled call: $*" >&2
  exit 2
fi

call="${logline% }"

case "$call" in
  *mutation*)
    case "$call" in
      *updateIssue*)
        if [ "${FAKE_GH_UPDATE_FAIL:-}" = 1 ]; then
          printf '{"data":{"updateIssue":null},"errors":[{"type":"FORBIDDEN","message":"Resource not accessible by integration"}]}\n'
          echo "GraphQL: Resource not accessible by integration (updateIssue)" >&2
          exit 1
        fi
        printf '{"data":{"updateIssue":{"issue":{"number":40}}}}\n'
        exit 0
        ;;
      *'addBlockedBy(input:{issueId:"'*'",blockingIssueId:"I_FAIL"})'*)
        # Real gh puts the error JSON on stdout and a summary on stderr.
        printf '{"data":{"addBlockedBy":null},"errors":[{"type":"NOT_FOUND","message":"Could not resolve to a node with the global id of '"'"'I_FAIL'"'"'"}]}\n'
        echo "GraphQL: Could not resolve to a node with the global id of 'I_FAIL' (addBlockedBy)" >&2
        exit 1
        ;;
      *'addSubIssue(input:{issueId:"'*'",subIssueId:"'*)
        printf '{"data":{"addSubIssue":{"issue":{"number":40}}}}\n'
        exit 0
        ;;
      *'addBlockedBy(input:{issueId:"'*'",blockingIssueId:"'*)
        printf '{"data":{"addBlockedBy":{"issue":{"number":40}}}}\n'
        exit 0
        ;;
    esac
    echo "fake-gh: unhandled mutation: $*" >&2
    exit 2
    ;;
esac

case "$call" in
  *'repository(owner:"o",name:"r")'*) ;;
  # A second repo under the same owner, so the suite can show that the
  # same-owner rule for parents keys on the owner and not on the repo.
  *'repository(owner:"o",name:"other")'*) ;;
  *)
    echo "GraphQL: Could not resolve to a Repository with the name requested." >&2
    exit 1
    ;;
esac

# viewerPermission comes from FAKE_GH_PERMS, "owner/repo=LEVEL,..." with the
# literal LEVEL null for a repo the viewer cannot see into. Unlisted repos
# answer WRITE, which is what the pre-permission cases were written against.
repo_key="$(printf '%s' "$call" | sed -n 's/.*repository(owner:"\([^"]*\)",name:"\([^"]*\)").*/\1\/\2/p')"
perm=WRITE
for pair in $(printf '%s' "${FAKE_GH_PERMS:-}" | tr ',' ' '); do
  case "$pair" in "$repo_key="*) perm="${pair#*=}" ;; esac
done
if [ "$perm" = null ]; then perm_json=null; else perm_json="\"$perm\""; fi

# The body query reads the canned body in FAKE_GH_BODY, so a strip case can
# check which lines survived.
case "$call" in
  *'issue(number:40){id body}'*)
    python3 -c 'import json,sys; print(json.dumps({"data":{"repository":{"issue":{"id":"I_40","body":open(sys.argv[1]).read()}}}}))' "${FAKE_GH_BODY:?FAKE_GH_BODY must name the canned body}"
    exit 0
    ;;
esac

case "$call" in
  *'issue(number:'*) ;;
  *viewerPermission*)
    printf '{"data":{"repository":{"viewerPermission":%s}}}\n' "$perm_json"
    exit 0
    ;;
esac

case "$call" in
  *'issue(number:12)'*) node='"I_12"' ;;
  *'issue(number:7)'*) node='"I_7"' ;;
  *'issue(number:40)'*) node='"I_40"' ;;
  # #99 has no issue and #5 is a pull request. The fake answers both with a
  # null issue; whether real GitHub answers a PR number with null or with a
  # GraphQL error is unverified live (EVALS scenario 10), and the script maps
  # either to node: null.
  *'issue(number:99)'*) node='' ;;
  *'issue(number:5)'*) node='' ;;
  *)
    echo "fake-gh: no canned node for: $*" >&2
    exit 1
    ;;
esac

case "$call" in
  *viewerPermission*) perm_field="\"viewerPermission\":$perm_json," ;;
  *) perm_field="" ;;
esac
if [ -n "$node" ]; then
  printf '{"data":{"repository":{%s"issue":{"id":%s}}}}\n' "$perm_field" "$node"
else
  printf '{"data":{"repository":{%s"issue":null}}}\n' "$perm_field"
fi
