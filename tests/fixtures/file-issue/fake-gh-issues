#!/bin/sh
# Stand-in for gh in the check-relationships.py block of
# tests/file-issue-smoke.sh. It answers a repo lookup and the open-issues page
# and fails every other call, so a mutation fails here as well as in the
# suite's log check. It stays separate from fake-gh so neither stub's routing
# takes on a second job.
printf '%s\n' "$*" >> "${FAKE_GH_LOG:?FAKE_GH_LOG must name the call log}"

if [ "$1" = "repo" ] && [ "$2" = "view" ]; then
  printf '{"nameWithOwner":"o/r"}\n'
  exit 0
fi

if [ "$1" = "api" ] && [ "$2" = "graphql" ]; then
  case "$*" in
    *mutation*) ;;
    *'issues(states:OPEN'*)
      # FAKE_GH_FAIL fails the page request the way a real gh fails on a
      # network or auth error, so the suite can pin the script's exit 3.
      if [ "${FAKE_GH_FAIL:-}" = 1 ]; then
        echo "HTTP 502: Bad Gateway (https://api.github.com/graphql)" >&2
        exit 1
      fi
      cat "${FAKE_GH_PAGE:?FAKE_GH_PAGE must name the canned issues page}"
      exit 0
      ;;
  esac
fi

echo "fake-gh-issues: unhandled call: $*" >&2
exit 2
