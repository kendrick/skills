#!/usr/bin/env bash
# Stands in for `gh` when the smoke suite drives run-state.py's gh() into a
# timeout. STUB_GH_MODE picks the behavior, and STUB_GH_COUNT counts calls the
# way stub-review does, so a case can tell a retry from a single attempt.
#   hang-once     hang on call 1, then print {"ok": 1}
#   hang-always   hang on every call
#   fail-404      exit 1 with `HTTP 404` on stderr
#   hang-then-404 hang on call 1, then fail as fail-404
# The hang is `exec sleep` so that the process subprocess.run kills on timeout
# is the sleeper itself. A `sleep` child would keep the pipes open, and the
# post-kill wait would last the whole sleep. Keep the sleep short, so a broken
# retry still lets the suite finish in seconds.
set -euo pipefail

n=$(( $(cat "$STUB_GH_COUNT" 2>/dev/null || echo 0) + 1 ))
echo "$n" >"$STUB_GH_COUNT"

hang() { exec sleep 5; }
fail_404() {
  echo "gh: Not Found (HTTP 404)" >&2
  exit 1
}

case "${STUB_GH_MODE:?STUB_GH_MODE is unset}" in
  hang-once) (( n == 1 )) && hang; echo '{"ok": 1}' ;;
  hang-always) hang ;;
  fail-404) fail_404 ;;
  hang-then-404) (( n == 1 )) && hang; fail_404 ;;
  *)
    echo "stub-gh: unknown STUB_GH_MODE $STUB_GH_MODE" >&2
    exit 2
    ;;
esac
